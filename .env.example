# Public production HTTPS origin, without path/query/fragment. Set before building.
# Missing: noindex, canonical/OG URL omitted, sitemap has no entries.
# Rebuild after changing this value. Never use a guessed domain.
SITE_URL=

# Server-only contact values. Copy to .env.local; never add NEXT_PUBLIC_ prefixes.
# Exact public origin, no trailing slash. Local development: http://localhost:3000
CONTACT_ALLOWED_ORIGIN=
# Resend API key with sending permission and a provider-verified sending domain.
RESEND_API_KEY=
# Single bare mailboxes; owner must supply and verify both. No display names.
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
# Required shared limiter in all environments. No inquiry content is stored here.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Admin Auth/Database/Storage: server-only, no NEXT_PUBLIC_ prefixes required.
# HTTPS Supabase project origin and its sb_publishable_ key (NOT secret/service_role).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# One existing Auth user's UUID, also configured in private.portfolio_admin via SQL.
SUPABASE_ADMIN_USER_ID=
# Optional server-only Supabase secret key for the approved public asset proxy.
# Never NEXT_PUBLIC_, never use for admin actions. Missing: photo/CV/screenshots hidden.
# Public text reads use only SUPABASE_URL + SUPABASE_PUBLISHABLE_KEY.
SUPABASE_SECRET_KEY=
